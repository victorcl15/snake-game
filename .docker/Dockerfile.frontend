# ============================================================
# SNAKE GAME 3D - Frontend Dockerfile (Multistage Build)
# React 18 + Babylon.js 7 + Vite + TypeScript
# ============================================================

# Stage 1: Builder
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY frontend/package*.json ./

# Install dependencies with npm ci (reproducible)
RUN npm ci --frozen-lockfile

# Copy source code
COPY frontend/src ./src
COPY frontend/public ./public
COPY frontend/vite.config.ts ./
COPY frontend/tsconfig.json ./
COPY frontend/tsconfig.app.json ./
COPY frontend/index.html ./

# Clean up any stale .d.ts files
RUN find ./src -name "*.d.ts" -delete 2>/dev/null || true

# Build frontend (optimized for production)
RUN npm run build

# ============================================================
# Stage 2: Production - Nginx (Plain Alpine)
# ============================================================
FROM alpine:latest

# Install nginx only (no complex entrypoint)
RUN apk add --no-cache nginx

# Copy nginx configuration (frontend-specific)
COPY nginx/nginx-frontend.conf /etc/nginx/nginx.conf

# Copy built frontend from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Make sure directories have proper permissions
RUN mkdir -p /var/cache/nginx /var/log/nginx && \
    chmod -R 755 /var/cache/nginx /var/log/nginx && \
    chown -R root:root /usr/share/nginx/html

# Create entrypoint
RUN mkdir -p /var/run/nginx

# Expose port (mapped from 80 internally to 3000 externally)
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:80/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
