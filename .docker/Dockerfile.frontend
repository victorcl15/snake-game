# ============================================================
# SNAKE GAME 3D - Frontend Dockerfile (Multistage Build)
# React 18 + Babylon.js 7 + Vite + TypeScript
# ============================================================

# Stage 1: Builder
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY frontend/package*.json ./

# Install dependencies with npm ci
RUN npm ci

# Copy source code and config
COPY frontend/src ./src
COPY frontend/public ./public
COPY frontend/vite.config.ts ./
COPY frontend/tsconfig.json ./
COPY frontend/tsconfig.app.json ./
COPY frontend/index.html ./

# Build frontend (optimized for production)
RUN npm run build

# ============================================================
# Stage 2: Production - Nginx (Plain Alpine)
# ============================================================
FROM alpine:latest

# Install nginx
RUN apk add --no-cache nginx

# Copy nginx configuration (frontend-specific)
COPY nginx/nginx-frontend.conf /etc/nginx/nginx.conf

# Copy built frontend from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Make sure directories have proper permissions
RUN mkdir -p /var/cache/nginx /var/log/nginx /var/run/nginx && \
    chmod -R 755 /var/cache/nginx /var/log/nginx && \
    chown -R nginx:nginx /usr/share/nginx/html

# Expose port (mapped from 80 internally to 3000 externally)
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:80/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
