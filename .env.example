# ============================================================
# Snake Game 3D - Environment Variables Template
# ============================================================

NODE_ENV=development

# Database - MongoDB
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=admin-password
MONGO_DB_NAME=snake_game
MONGODB_URI=mongodb://admin:admin-password@mongodb:27017/snake_game?authSource=admin

# Backend Server
PORT=4000
SOCKET_PORT=4001
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=dev-secret-key-change-in-prod

# Frontend URLs & Developer Settings
VITE_API_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4001
VITE_UNLOCK_ALL_LEVELS=true
VITE_DEV_MODE=true

# Docker Configuration
DOCKER_REGISTRY=docker.io
DOCKER_IMAGE_PREFIX=yourusername
