{
  "name": "snake-game-aaa-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Snake Game 3D - Express 4 + Socket.io Backend",
  "author": "Victor Manuel Calle Londoño",
  "license": "MIT",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --loader ts-node/esm src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "express": "^4.18.0",
    "socket.io": "^4.7.0",
    "mongoose": "^8.0.0",
    "cors": "^2.8.0",
    "dotenv": "^16.0.0",
    "jsonwebtoken": "^9.1.0",
    "bcryptjs": "^2.4.0",
    "winston": "^3.11.0",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@types/cors": "^2.8.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.2.0"
  }
}
